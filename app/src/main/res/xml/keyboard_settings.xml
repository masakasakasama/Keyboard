<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <SeekBarPreference
        android:key="key_height_dp"
        android:title="@string/settings_keyboard_height"
        android:summary="@string/settings_height_summary"
        android:defaultValue="56"
        android:min="44"
        android:max="80" />

    <SeekBarPreference
        android:key="key_width_scale"
        android:title="@string/settings_keyboard_width"
        android:summary="@string/settings_width_summary"
        android:defaultValue="100"
        android:min="70"
        android:max="100" />

    <Preference
        android:key="user_dictionary"
        android:title="ユーザー辞書"
        android:summary="自分だけの単語を登録・管理" />

    <EditTextPreference
        android:key="groq_api_key"
        android:title="Groq API キー（無料）"
        android:summary="日本語・英語AI予測変換に使用。groq.com で無料取得"
        android:inputType="textPassword" />

</PreferenceScreen>
